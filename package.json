{
  "name": "x-mcp",
  "version": "0.1.0",
  "description": "Standalone MCP server for the X API v2 with Composio Twitter toolkit coverage",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "x-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod 755 build/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
